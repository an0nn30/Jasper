=== dz deletes up to the match
text:
  one two three two
  four twofold two
  five
  two and tw
cursor: 1,1
ext: sneak
keys: dztw
registers: " 0 1 -
--- vim 9.1
expect-text:
  two three two
  four twofold two
  five
  two and tw
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "one "
expect-register 0: none
expect-register 1: none
expect-register -: c "one "

