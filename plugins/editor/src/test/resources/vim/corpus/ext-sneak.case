# sneak (plan V4d): s, S, z, Z, ; and , over two characters.

=== s goes to the next two characters
text:
  one two three two
  four twofold two
  five
  two and tw
cursor: 1,1
ext: sneak
keys: stw
--- vim 9.1
expect-text:
  one two three two
  four twofold two
  five
  two and tw
expect-cursor: 1,5
expect-mode: normal

=== s past the line
text:
  one two three two
  four twofold two
  five
  two and tw
cursor: 1,15
ext: sneak
keys: stw
--- vim 9.1
expect-text:
  one two three two
  four twofold two
  five
  two and tw
expect-cursor: 2,6
expect-mode: normal

