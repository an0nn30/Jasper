=== the default mappings
text:
  a
cursor: 1,1
ext: sneak
keys: :nmap s<CR>:omap z<CR>:xmap Z<CR>:nmap ;<CR>
output: yes
--- vim 9.1
expect-text:
  a
expect-cursor: 1,1
expect-mode: normal
expect-output:
  n  s             <Plug>Sneak_s
  o  z             <Plug>Sneak_s
  x  Z             <Plug>Sneak_S
  n  ;             <Plug>Sneak_;

