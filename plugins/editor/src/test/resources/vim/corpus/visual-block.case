# Blockwise Visual mode and blockwise registers.

=== C-v then j then l
text:
  abcdef
  ghijkl
  mnopqr
cursor: 1,2
keys: <C-v>jl
--- vim 9.1
expect-text:
  abcdef
  ghijkl
  mnopqr
expect-cursor: 2,3
expect-mode: visual-block
expect-visual: 1,2

=== C-v then d
text:
  abcdef
  ghijkl
  mnopqr
cursor: 1,2
keys: <C-v>jld
registers: " 0 1 -
--- vim 9.1
expect-text:
  adef
  gjkl
  mnopqr
expect-cursor: 1,2
expect-mode: normal
expect-register ": b2 "bc\nhi"
expect-register 0: none
expect-register 1: b2 "bc\nhi"
expect-register -: none

