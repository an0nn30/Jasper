=== C-v then p replaces the block
text:
  abcdef
  ghijkl
  mnopqr
cursor: 1,2
keys: yl<C-v>jlp
registers: " 0 1 -
--- vim 9.1
expect-text:
  abdef
  gbjkl
  mnopqr
expect-cursor: 1,2
expect-mode: normal
expect-register ": b2 "bc\nhi"
expect-register 0: c "b"
expect-register 1: b2 "bc\nhi"
expect-register -: none

