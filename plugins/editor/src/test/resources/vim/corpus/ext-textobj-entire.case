=== the default mappings
text:
  a
cursor: 1,1
ext: textobj-entire
keys: :omap ae<CR>:xmap ie<CR>
output: yes
--- vim 9.1
expect-text:
  a
expect-cursor: 1,1
expect-mode: normal
expect-output:
  o  ae            <Plug>(textobj-entire-a)
  x  ie            <Plug>(textobj-entire-i)

=== no default mappings
text:
  a
  b
cursor: 1,1
ext: textobj-entire
let: g:textobj_entire_no_default_key_mappings = 1
keys: dae
registers: " 0 1 -
--- vim 9.1
expect-text:
  a
  b
expect-cursor: 1,1
expect-mode: normal
expect-register ": none
expect-register 0: none
expect-register 1: none
expect-register -: none

=== an own mapping of the plug
text:
  a
  b
cursor: 1,1
ext: textobj-entire
keys: :omap Q <lt>Plug>(textobj-entire-a)<CR>dQ
registers: " 0 1 -
--- vim 9.1
expect-text:
  $
expect-cursor: 1,1
expect-mode: normal
expect-register ": l "a\nb\n"
expect-register 0: none
expect-register 1: l "a\nb\n"
expect-register -: none
