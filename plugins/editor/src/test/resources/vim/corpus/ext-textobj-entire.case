  ab
  cd
  ef
cursor: 2,2
ext: textobj-entire
keys: d<C-v>ie
registers: " 0 1 -
--- vim 9.1
expect-text:
  $
  $
  $
expect-cursor: 1,1
expect-mode: normal
expect-register ": b2 "ab\ncd\nef"
expect-register 0: none
expect-register 1: b2 "ab\ncd\nef"
expect-register -: none

