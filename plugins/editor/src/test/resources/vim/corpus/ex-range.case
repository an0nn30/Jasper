# Ex command line: addresses, ranges, counts and errors (V2a).

=== colon number goes to the line
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :5<CR>
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 5,1
expect-mode: normal

=== colon number keeps the first non-blank
text:
  alpha
    beta
      gamma
  delta
cursor: 1,1
keys: :3<CR>
--- vim 9.1
expect-text:
  alpha
    beta
      gamma
  delta
expect-cursor: 3,5
expect-mode: normal

=== colon number past the end goes to the last line
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :99<CR>
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 10,1
expect-mode: normal

