=== semicolon moves the cursor even if the command fails
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :4;foo<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 4,1
expect-mode: normal
expect-output:
  E492: Not an editor command: 4;foo

=== semicolon zero then search finds the first line
text:
  abc
  x
  abc
cursor: 2,1
keys: :0;/abc/d<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  x
  abc
expect-cursor: 1,1
expect-mode: normal
expect-register ": l "abc\n"
expect-register 0: none
expect-register 1: l "abc\n"
expect-register a: none
expect-register -: none

