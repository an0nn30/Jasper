=== closed fold counts as one line in a range
text:
  class A {
    void f() {
      x();
    }
    int y;
  }
cursor: 1,1
folds: java 2
keys: :2d<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  class A {
    int y;
  }
expect-cursor: 2,3
expect-mode: normal
expect-folds: none
expect-register ": l "  void f() {\n    x();\n  }\n"
expect-register 0: none
expect-register 1: l "  void f() {\n    x();\n  }\n"
expect-register a: none
expect-register -: none

