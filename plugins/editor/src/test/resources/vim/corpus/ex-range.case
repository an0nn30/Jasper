=== comma range
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :2,4d<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  one
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 2,1
expect-mode: normal
expect-register ": l "two\nthree\nfour\n"
expect-register 0: none
expect-register 1: l "two\nthree\nfour\n"
expect-register a: none
expect-register -: none

=== semicolon range counts from the first
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :3;+2d<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  one
  two
  six
  seven
  eight
  nine
  ten
expect-cursor: 3,1
expect-mode: normal
expect-register ": l "three\nfour\nfive\n"
expect-register 0: none
expect-register 1: l "three\nfour\nfive\n"
expect-register a: none
expect-register -: none

