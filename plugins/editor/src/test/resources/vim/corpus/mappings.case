  d4
  e5
  f6
expect-cursor: 2,1
expect-mode: normal

=== zero after count digits is not mapped
text:
  a1
  b2
  c3
  d4
  e5
  f6
  g7
  h8
  i9
  j10
  k11
  l12
cursor: 1,1
keys: :nmap 0 dd<CR>10j0
--- vim 9.1
expect-text:
  a1
  b2
  c3
  d4
  e5
  f6
  g7
  h8
  i9
  j10
  l12
expect-cursor: 11,1
expect-mode: normal

=== a register applies to a mapping
text:
  one two three
  four five six
  seven eight nine
  ten eleven twelve
cursor: 1,1
keys: :nmap x yy<CR>"ax
registers: a
--- vim 9.1
expect-text:
  one two three
  four five six
  seven eight nine
  ten eleven twelve
expect-cursor: 1,1
expect-mode: normal
expect-register a: l "one two three\n"

