# Mappings: :map and its forms define, list and remove mappings; keys are mapped before they run.

=== nmap maps a key
text:
  one two three
  four five six
  seven eight nine
  ten eleven twelve
cursor: 2,1
keys: :nmap x dd<CR>x
--- vim 9.1
expect-text:
  one two three
  seven eight nine
  ten eleven twelve
expect-cursor: 2,1
expect-mode: normal

=== a mapping's changes undo together
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :nmap x ddjdd<CR>xu
--- vim 9.1
expect-text:
  a1
  b2
  c3
  d4
  e5
  f6
expect-cursor: 1,1
expect-mode: normal

=== a typed key after a mapping starts a new undo step
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :nmap x dd<CR>xxu
--- vim 9.1
expect-text:
  b2
  c3
  d4
  e5
  f6
expect-cursor: 1,1
expect-mode: normal

=== nnoremap does not map its right-hand side again
text:
  one two three
  four five six
  seven eight nine
  ten eleven twelve
cursor: 1,1
keys: :nmap x dd<CR>:nnoremap y x<CR>y
--- vim 9.1
expect-text:
  ne two three
  four five six
  seven eight nine
  ten eleven twelve
expect-cursor: 1,1
expect-mode: normal

=== nmap maps its right-hand side again
text:
  one two three
  four five six
  seven eight nine
  ten eleven twelve
cursor: 1,1
keys: :nmap x dd<CR>:nmap y x<CR>y
--- vim 9.1
expect-text:
  four five six
  seven eight nine
  ten eleven twelve
expect-cursor: 1,1
expect-mode: normal

=== a right-hand side starting with its left-hand side
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :nmap j jj<CR>j
--- vim 9.1
expect-text:
  a1
  b2
  c3
  d4
  e5
  f6
expect-cursor: 6,1
expect-mode: normal

=== mappings that map each other fail with E223
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :nmap x y<CR>:nmap y x<CR>xj
output: yes
--- vim 9.1
expect-text:
  a1
  b2
  c3
  d4
  e5
  f6
expect-cursor: 2,1
expect-mode: normal
expect-output:
  E223: Recursive mapping

=== maxmapdepth limits the depth
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :set mmd=3<CR>:nmap a b<CR>:nmap b c<CR>:nmap c dd<CR>a
output: yes
--- vim 9.1
expect-text:
  a1
  b2
  c3
  d4
  e5
  f6
expect-cursor: 1,1
expect-mode: normal
expect-output:
  E223: Recursive mapping

=== maxmapdepth deep enough
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :set mmd=4<CR>:nmap a b<CR>:nmap b c<CR>:nmap c dd<CR>a
--- vim 9.1
expect-text:
  b2
  c3
  d4
  e5
  f6
expect-cursor: 1,1
expect-mode: normal

=== a count applies to the first command of a mapping
text:
  a1
  b2
  c3
  d4
  e5
  f6
cursor: 1,1
keys: :nmap x ddj<CR>2x
--- vim 9.1
expect-text:
