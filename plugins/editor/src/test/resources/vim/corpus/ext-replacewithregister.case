  one
expect-cursor: 2,1
expect-mode: normal
expect-register ": c "one"

=== gr over a block repeats the register
text:
  one two three
  four five six
  seven eight nine
cursor: 1,1
ext: replacewithregister
keys: yiw<C-v>jlgr
registers: "
--- vim 9.1
expect-text:
  onee two three
  oneur five six
  seven eight nine
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "one"

=== dot repeats gr
text:
  one two three
  four five six
  seven eight nine
cursor: 1,1
ext: replacewithregister
keys: yiwwgriwj0.
registers: "
--- vim 9.1
expect-text:
  one one three
  one five six
  seven eight nine
expect-cursor: 2,3
expect-mode: normal
expect-register ": c "one"

=== dot repeats grr
text:
  one two three
  four five six
  seven eight nine
cursor: 1,1
ext: replacewithregister
keys: yyjgrrj.
registers: "
--- vim 9.1
expect-text:
  one two three
  one two three
  one two three
expect-cursor: 3,1
expect-mode: normal
expect-register ": l "one two three\n"

=== gr over nothing puts before the cursor
text:
  one two three
  four five six
  seven eight nine
cursor: 1,5
ext: replacewithregister
keys: yiwgr0
--- vim 9.1
expect-text:
  twotwo three
  four five six
  seven eight nine
expect-cursor: 1,3
expect-mode: normal

=== the default mappings
text:
  one two three
  four five six
  seven eight nine
cursor: 1,1
ext: replacewithregister
keys: :nmap gr<CR>:xmap gr<CR>
output: yes
--- vim 9.1
expect-text:
  one two three
  four five six
  seven eight nine
expect-cursor: 1,1
expect-mode: normal
expect-output:
  n  grr           <Plug>ReplaceWithRegisterLine
  n  gr            <Plug>ReplaceWithRegisterOperator
  x  gr            <Plug>ReplaceWithRegisterVisual
