  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal
expect-output:
  E492: Not an editor command: sxfooxbarx

=== s without closing delimiter
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/foo/X<CR>
--- vim 9.1
expect-text:
  X bar foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
