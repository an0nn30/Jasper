=== s without a substitute deletes
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/foo<CR>
--- vim 9.1
expect-text:
   bar foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,2
expect-mode: normal

=== s ampersand is the match
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/fo*/<&>/g<CR>
--- vim 9.1
expect-text:
  <foo> bar <foo>
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal

=== s backslash zero is the match
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/bar/[\0]/<CR>
--- vim 9.1
expect-text:
  foo [bar] foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal

=== s groups
text:
  john smith
cursor: 1,1
keys: :s/\(\w\+\) \(\w\+\)/\2, \1/<CR>
--- vim 9.1
expect-text:
  smith, john
expect-cursor: 1,1
expect-mode: normal

=== s upper case one
text:
  hello world
cursor: 1,1
keys: :s/\w\+/\u&/g<CR>
--- vim 9.1
expect-text:
  Hello World
expect-cursor: 1,1
expect-mode: normal

=== s upper case all
text:
  hello world
cursor: 1,1
keys: :s/o w/\U&/<CR>
--- vim 9.1
expect-text:
  hellO World
expect-cursor: 1,1
expect-mode: normal

=== s upper case until e
text:
  hello world
cursor: 1,1
keys: :s/\(hello\) \(world\)/\U\1\e \2/<CR>
--- vim 9.1
expect-text:
  HELLO world
expect-cursor: 1,1
expect-mode: normal

=== s lower case
text:
  HELLO WORLD
cursor: 1,1
keys: :s/\w\+/\L&/<CR>
--- vim 9.1
expect-text:
  hello WORLD
expect-cursor: 1,1
expect-mode: normal

=== s lower then upper first
text:
  hELLO
cursor: 1,1
keys: :s/.*/\L\u&/<CR>
--- vim 9.1
expect-text:
  Hello
expect-cursor: 1,1
expect-mode: normal

=== s backslash r splits the line
text:
  a,b,c
cursor: 1,1
keys: :s/,/\r/g<CR>
--- vim 9.1
expect-text:
