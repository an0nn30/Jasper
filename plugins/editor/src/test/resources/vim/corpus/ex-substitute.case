# Ex :s, :&, :&&, :~, & and g& (V2a).

=== s replaces the first match
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/foo/X/<CR>
--- vim 9.1
expect-text:
  X bar foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal

=== s g replaces all in the line
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/foo/X/g<CR>
--- vim 9.1
expect-text:
  X bar X
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal

=== s on a range
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :%s/foo/X/<CR>
output: yes
--- vim 9.1
expect-text:
  X bar foo
  bar X
  baz
  X foo foo
expect-cursor: 4,1
expect-mode: normal
expect-output:
  3 substitutions on 3 lines

=== s g on all lines reports
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :%s/foo/X/g<CR>
output: yes
--- vim 9.1
expect-text:
  X bar X
  bar X
  baz
  X X X
expect-cursor: 4,1
expect-mode: normal
expect-output:
  6 substitutions on 3 lines

=== s puts the cursor on the last changed line
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :%s/foo/X/<CR>
--- vim 9.1
expect-text:
  X bar foo
  bar X
  baz
  X foo foo
expect-cursor: 4,1
expect-mode: normal

=== s cursor goes to the first non-blank
text:
    foo
    bar
cursor: 2,1
keys: :%s/foo/X/<CR>
--- vim 9.1
expect-text:
    X
    bar
expect-cursor: 1,3
expect-mode: normal

=== s not found
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/zzz/X/<CR>
output: yes
--- vim 9.1
expect-text:
  foo bar foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal
expect-output:
  E486: Pattern not found: zzz

=== s not found with e is silent
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/zzz/X/e<CR>
output: yes
--- vim 9.1
expect-text:
