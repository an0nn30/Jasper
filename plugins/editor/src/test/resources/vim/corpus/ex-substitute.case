  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal
expect-output:

=== s with an empty pattern uses the last search
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 2,1
keys: /bar<CR>:s//X/<CR>
--- vim 9.1
expect-text:
  foo X foo
  bar foo
  baz
  foo foo foo
expect-cursor: 1,1
expect-mode: normal

=== s sets the last search for n
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :s/bar/X/<CR>n
--- vim 9.1
expect-text:
  foo X foo
  bar foo
  baz
  foo foo foo
expect-cursor: 2,1
expect-mode: normal

=== s pattern with a different delimiter
text:
  a/b/c
cursor: 1,1
keys: :s#/#-#g<CR>
--- vim 9.1
expect-text:
  a-b-c
expect-cursor: 1,1
expect-mode: normal

=== s delimiter escaped in the pattern
text:
  a/b/c
cursor: 1,1
keys: :s/\//-/<CR>
--- vim 9.1
expect-text:
  a-b/c
expect-cursor: 1,1
expect-mode: normal

=== s letters as delimiter fail
text:
  foo bar foo
  bar foo
  baz
  foo foo foo
cursor: 1,1
keys: :sxfooxbarx<CR>
output: yes
--- vim 9.1
expect-text:
