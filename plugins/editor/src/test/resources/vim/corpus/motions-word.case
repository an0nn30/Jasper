# Word motions, alone and with operators.

=== w moves to the next word
text:
  one two three
cursor: 1,1
keys: w
--- vim 9.1
expect-text:
  one two three
expect-cursor: 1,5
expect-mode: normal

=== w stops at punctuation
text:
  foo.bar baz
cursor: 1,1
keys: w
--- vim 9.1
expect-text:
  foo.bar baz
expect-cursor: 1,4
expect-mode: normal

=== 3w crosses lines
text:
  one two
  three four
cursor: 1,1
keys: 3w
--- vim 9.1
expect-text:
  one two
  three four
expect-cursor: 2,7
expect-mode: normal

=== w stops on an empty line
text:
  one
  $
  two
cursor: 1,1
keys: w
--- vim 9.1
expect-text:
  one
  $
  two
expect-cursor: 2,1
expect-mode: normal

=== w on the last word goes to its end
text:
  one two
cursor: 1,5
keys: w
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,7
expect-mode: normal

=== w on the last character of the text fails
text:
  one two
cursor: 1,7
keys: wx
--- vim 9.1
expect-text:
  one tw
expect-cursor: 1,6
expect-mode: normal

=== W skips punctuation
text:
  foo.bar baz
cursor: 1,1
keys: W
--- vim 9.1
expect-text:
  foo.bar baz
expect-cursor: 1,9
expect-mode: normal

=== b goes back to the start of the word
text:
  one two
cursor: 1,6
keys: b
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,5
expect-mode: normal

=== b from a word start goes to the previous word
text:
  one two
cursor: 1,5
keys: b
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,1
expect-mode: normal

=== 2b crosses lines
text:
  one two
  three
cursor: 2,3
keys: 2b
--- vim 9.1
expect-text:
  one two
  three
expect-cursor: 1,5
expect-mode: normal

=== b stops on an empty line
text:
  one
  $
  two
cursor: 3,1
keys: b
--- vim 9.1
expect-text:
  one
  $
  two
expect-cursor: 2,1
expect-mode: normal

=== B skips punctuation
text:
  foo.bar baz
cursor: 1,9
keys: B
--- vim 9.1
expect-text:
  foo.bar baz
expect-cursor: 1,1
expect-mode: normal

=== b at the start fails
text:
  one
cursor: 1,1
keys: bx
--- vim 9.1
expect-text:
  ne
expect-cursor: 1,1
expect-mode: normal

=== e goes to the end of the word
text:
  one two
cursor: 1,1
keys: e
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,3
expect-mode: normal

=== e from the end goes to the next end
text:
  one two
cursor: 1,3
keys: e
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,7
expect-mode: normal

=== e over punctuation
text:
  foo.bar
cursor: 1,1
keys: ee
--- vim 9.1
expect-text:
  foo.bar
expect-cursor: 1,4
expect-mode: normal

=== E goes to the end of the WORD
text:
  foo.bar baz
cursor: 1,1
keys: E
--- vim 9.1
expect-text:
  foo.bar baz
expect-cursor: 1,7
expect-mode: normal

=== ge goes back to the previous end
text:
  one two
cursor: 1,6
keys: ge
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,3
expect-mode: normal

=== gE goes back to the previous WORD end
text:
  foo.bar baz
cursor: 1,10
keys: gE
--- vim 9.1
expect-text:
  foo.bar baz
expect-cursor: 1,7
expect-mode: normal

=== w with keywords set to include dashes
set: iskeyword+=-
text:
  foo-bar baz
cursor: 1,1
keys: w
--- vim 9.1
expect-text:
  foo-bar baz
expect-cursor: 1,9
expect-mode: normal

=== w between CJK and Latin
text:
  日本abc def
cursor: 1,1
keys: w
--- vim 9.1
expect-text:
  日本abc def
expect-cursor: 1,3
expect-mode: normal

=== dw deletes to the next word
text:
  one two three
cursor: 1,5
keys: dw
registers: " -
--- vim 9.1
expect-text:
  one three
expect-cursor: 1,5
expect-mode: normal
expect-register ": c "two "
expect-register -: c "two "

=== dw on the last word of a line stops at the end of the line
text:
  one two
  three
cursor: 1,5
keys: dw
registers: " -
--- vim 9.1
expect-text:
  one $
  three
expect-cursor: 1,4
expect-mode: normal
expect-register ": c "two"
expect-register -: c "two"

=== 2dw crosses a line end
text:
  one two
  three four
cursor: 1,5
keys: 2dw
registers: " 1
--- vim 9.1
expect-text:
  one four
expect-cursor: 1,5
expect-mode: normal
expect-register ": c "two\nthree "
expect-register 1: c "two\nthree "

=== dw on an empty line deletes the line
text:
  one
  $
  two
cursor: 2,1
keys: dw
registers: " 1
--- vim 9.1
expect-text:
  one
  two
expect-cursor: 2,1
expect-mode: normal
expect-register ": l "\n"
expect-register 1: l "\n"

=== dw on the last word of the text
text:
  one two
cursor: 1,5
keys: dw
--- vim 9.1
expect-text:
  one $
expect-cursor: 1,4
expect-mode: normal

=== dw on the last character of the text
text:
  one two
cursor: 1,7
keys: dw
--- vim 9.1
expect-text:
  one tw
expect-cursor: 1,6
expect-mode: normal

=== dW deletes a WORD
text:
  foo.bar baz
cursor: 1,1
keys: dW
--- vim 9.1
expect-text:
  baz
expect-cursor: 1,1
expect-mode: normal

=== cw changes to the end of the word
text:
  one two three
cursor: 1,5
keys: cwTWO<Esc>
registers: "
--- vim 9.1
expect-text:
  one TWO three
expect-cursor: 1,7
expect-mode: normal
expect-register ": c "two"

=== cw on a one-letter word
text:
  a b c
cursor: 1,3
keys: cwx<Esc>
--- vim 9.1
expect-text:
  a x c
expect-cursor: 1,3
expect-mode: normal

=== cw on white space
text:
  one   two
cursor: 1,4
keys: cwX<Esc>
--- vim 9.1
expect-text:
  oneXtwo
expect-cursor: 1,4
expect-mode: normal

=== 2cw changes two words
text:
  one two three
cursor: 1,1
keys: 2cwX<Esc>
--- vim 9.1
expect-text:
  X three
expect-cursor: 1,1
expect-mode: normal

=== cW changes a WORD
text:
  foo.bar baz
cursor: 1,1
keys: cWX<Esc>
--- vim 9.1
expect-text:
  X baz
expect-cursor: 1,1
expect-mode: normal

=== de deletes to the end of the word
text:
  one two
cursor: 1,1
keys: de
--- vim 9.1
expect-text:
   two
expect-cursor: 1,1
expect-mode: normal

=== db deletes back to the word start
text:
  one two
cursor: 1,7
keys: db
--- vim 9.1
expect-text:
  one o
expect-cursor: 1,5
expect-mode: normal

=== dge deletes back to the previous end
text:
  one two
cursor: 1,6
keys: dge
--- vim 9.1
expect-text:
  ono
expect-cursor: 1,3
expect-mode: normal

=== yw yanks a word
text:
  one two
cursor: 1,1
keys: yw
registers: " 0
--- vim 9.1
expect-text:
  one two
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "one "
expect-register 0: c "one "
