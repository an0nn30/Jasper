# Search: / ? n N * # g* g#, offsets, the command line, and case rules.

=== slash finds the next match
text:
  the cat sat on the mat
  a dog and a cat
  the end
cursor: 1,1
keys: /cat<CR>
--- vim 9.1
expect-text:
  the cat sat on the mat
  a dog and a cat
  the end
expect-cursor: 1,5
expect-mode: normal

