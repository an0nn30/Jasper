=== d slash deletes up to the match
text:
  the cat sat on the mat
  a dog and a cat
  the end
cursor: 1,1
keys: d/cat<CR>
registers: " 0 1 -
--- vim 9.1
expect-text:
  cat sat on the mat
  a dog and a cat
  the end
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "the "
expect-register 0: none
expect-register 1: c "the "
expect-register -: c "the "

=== d slash with e offset is inclusive
text:
  the cat sat on the mat
  a dog and a cat
  the end
cursor: 1,1
keys: d/cat/e<CR>
registers: " 0 1 -
--- vim 9.1
expect-text:
   sat on the mat
  a dog and a cat
  the end
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "the cat"
expect-register 0: none
expect-register 1: c "the cat"
expect-register -: c "the cat"

=== d slash with a line offset is linewise
text:
  the cat sat on the mat
  a dog and a cat
  the end
cursor: 1,5
keys: d/dog/0<CR>
registers: " 0 1 -
--- vim 9.1
expect-text:
  the end
expect-cursor: 1,1
expect-mode: normal
expect-register ": l "the cat sat on the mat\na dog and a cat\n"
expect-register 0: none
expect-register 1: l "the cat sat on the mat\na dog and a cat\n"
expect-register -: none

