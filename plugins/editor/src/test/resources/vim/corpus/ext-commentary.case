=== the default mappings
text:
  def f():
      x = 1
      y = 2
  $
      return x
cursor: 1,1
set: cms=#\ %s
ext: commentary
keys: :nmap gc<CR>:omap gc<CR>:xmap gc<CR>
output: yes
--- vim 9.1
expect-text:
  def f():
      x = 1
      y = 2
  $
      return x
expect-cursor: 1,1
expect-mode: normal
expect-output:
  n  gcu           <Plug>Commentary<Plug>Commentary
  n  gcc           <Plug>CommentaryLine
  n  gc            <Plug>Commentary
  o  gc            <Plug>Commentary
  x  gc            <Plug>Commentary

=== the default commentstring
text:
  def f():
      x = 1
      y = 2
  $
      return x
cursor: 2,1
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  def f():
      /* x = 1 */
      y = 2
  $
      return x
expect-cursor: 2,1
expect-mode: normal

=== nested block comments are numbered
text:
  a /* b */ c
cursor: 1,1
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  /* a /1* b *1/ c */
expect-cursor: 1,1
expect-mode: normal

=== nested block comments are numbered back
text:
  /* a /1* b *1/ c */
cursor: 1,1
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  a /* b */ c
expect-cursor: 1,1
expect-mode: normal

=== a commentstring without spaces
text:
  x
  y
cursor: 1,1
set: cms=//%s
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  // x
  y
expect-cursor: 1,1
expect-mode: normal

=== uncommenting a comment without its space
text:
  //x
  //y
cursor: 1,1
set: cms=//%s
ext: commentary
keys: gcj
--- vim 9.1
expect-text:
  x
  y
expect-cursor: 1,1
expect-mode: normal

=== a commentstring with an end
text:
  <b>
  text
cursor: 1,1
set: cms=<!--%s-->
ext: commentary
keys: gcj
--- vim 9.1
expect-text:
  <!-- <b> -->
  <!-- text -->
expect-cursor: 1,1
expect-mode: normal
