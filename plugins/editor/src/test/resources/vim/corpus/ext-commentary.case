# commentary (tpope/vim-commentary): gc{motion}, gcc, Visual gc, gcu and the gc text object.

=== gcc comments a line
text:
  def f():
      x = 1
      y = 2
  $
      return x
cursor: 2,5
set: cms=#\ %s
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  def f():
      # x = 1
      y = 2
  $
      return x
expect-cursor: 2,5
expect-mode: normal

=== gcc uncomments a commented line
text:
  def f():
      # x = 1
      # y = 2
  $
      return x
cursor: 2,5
set: cms=#\ %s
ext: commentary
keys: gcc
--- vim 9.1
expect-text:
  def f():
      x = 1
      # y = 2
  $
      return x
expect-cursor: 2,5
expect-mode: normal

