=== dot repeats gc with a motion
text:
  def f():
      x = 1
      y = 2
  $
      return x
      z = 3
cursor: 2,1
set: cms=#\ %s
ext: commentary
keys: gcjjjj.
--- vim 9.1
expect-text:
  def f():
      # x = 1
      # y = 2
  $
      # return x
      # z = 3
expect-cursor: 5,1
expect-mode: normal

=== dgc deletes the comment block
text:
  def f():
      # x = 1
      # y = 2
  $
      return x
cursor: 3,1
set: cms=#\ %s
ext: commentary
keys: dgc
registers: "
--- vim 9.1
expect-text:
  def f():
      return x
expect-cursor: 2,5
expect-mode: normal
expect-register ": l "    # x = 1\n    # y = 2\n\n"

=== cgc changes the comment block
text:
  def f():
      # x = 1
      # y = 2
  $
      return x
cursor: 2,1
set: cms=#\ %s
ext: commentary
keys: cgcpass<Esc>
--- vim 9.1
expect-text:
