# paragraph-motion (plan V4b): { and } also stop at lines of white space.

=== } stops at a line of spaces
text:
  one
  two
  $
  three
     $
  four
  five
  	$
  six
cursor: 4,1
ext: vim-paragraph-motion
keys: }
--- vim 9.1
expect-text:
  one
  two
  $
  three
     $
  four
  five
  	$
  six
expect-cursor: 5,1
expect-mode: normal

