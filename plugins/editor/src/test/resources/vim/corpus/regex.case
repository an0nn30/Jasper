# The Vim regex translator, checked by searching.

=== regex dot
text:
  abc axc
cursor: 1,2
keys: /a.c<CR>
--- vim 9.1
expect-text:
  abc axc
expect-cursor: 1,5
expect-mode: normal

=== regex star
text:
  xab abbbc
cursor: 1,1
keys: /ab*c<CR>
--- vim 9.1
expect-text:
  xab abbbc
expect-cursor: 1,5
expect-mode: normal

=== regex backslash plus
text:
  ac abbc
cursor: 1,1
keys: /ab\+c<CR>
--- vim 9.1
expect-text:
  ac abbc
expect-cursor: 1,4
expect-mode: normal

=== regex backslash equals
text:
  abd ad
cursor: 1,1
keys: /ab\=d<CR>
--- vim 9.1
expect-text:
  abd ad
expect-cursor: 1,5
expect-mode: normal

=== regex backslash question
text:
  abd ad
cursor: 1,2
keys: /ab\?d<CR>
--- vim 9.1
expect-text:
  abd ad
expect-cursor: 1,5
expect-mode: normal

=== regex brace exact
text:
  aa aaa
cursor: 1,1
keys: /a\{3}<CR>
--- vim 9.1
expect-text:
  aa aaa
expect-cursor: 1,4
expect-mode: normal

=== regex brace range
text:
  x aaaa
cursor: 1,1
keys: /a\{2,3}<CR>e
--- vim 9.1
expect-text:
  x aaaa
expect-cursor: 1,6
expect-mode: normal

=== regex brace lazy
text:
  x aaaa
cursor: 1,1
keys: /a\{-2,}<CR>
--- vim 9.1
expect-text:
  x aaaa
expect-cursor: 1,3
expect-mode: normal

=== regex brace lazy with e
text:
  x aaaa
cursor: 1,1
keys: /a\{-2,}/e<CR>
--- vim 9.1
expect-text:
  x aaaa
expect-cursor: 1,4
expect-mode: normal

=== regex empty brace
text:
  x aaaa
cursor: 1,1
keys: /xa\{}/e<CR>
--- vim 9.1
expect-text:
  x aaaa
expect-cursor: 1,1
expect-mode: normal

=== regex alternation
text:
  one two three
cursor: 1,1
keys: /three\|two<CR>
--- vim 9.1
expect-text:
