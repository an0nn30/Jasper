expect-cursor: 1,4
expect-mode: normal

=== regex non capturing group
text:
  ab abab
cursor: 1,1
keys: /\%(ab\)\{2}<CR>
--- vim 9.1
expect-text:
  ab abab
expect-cursor: 1,4
expect-mode: normal

=== regex word boundaries
text:
  cat concat cat
cursor: 1,1
keys: /\<cat\><CR>
--- vim 9.1
expect-text:
  cat concat cat
expect-cursor: 1,12
expect-mode: normal

=== regex word start only
text:
  concat catalog
cursor: 1,1
keys: /\<cat<CR>
--- vim 9.1
expect-text:
  concat catalog
expect-cursor: 1,8
expect-mode: normal

=== regex very magic
text:
  ab abab
cursor: 1,1
keys: /\v(ab){2}<CR>
--- vim 9.1
expect-text:
  ab abab
expect-cursor: 1,4
expect-mode: normal

=== regex very magic alternation
text:
  one two three
cursor: 1,1
keys: /\vthree|two<CR>
--- vim 9.1
expect-text:
  one two three
expect-cursor: 1,5
expect-mode: normal

=== regex very magic word
text:
  cat concat cat
cursor: 1,5
keys: /\v<cat><CR>
--- vim 9.1
expect-text:
  cat concat cat
expect-cursor: 1,12
expect-mode: normal

=== regex nomagic
text:
  a.c abc
cursor: 1,2
keys: /\Ma.c<CR>
--- vim 9.1
expect-text:
  a.c abc
expect-cursor: 1,1
expect-mode: normal

=== regex very nomagic
text:
  a.c abc a*c
cursor: 1,2
keys: /\Va*c<CR>
--- vim 9.1
expect-text:
  a.c abc a*c
expect-cursor: 1,9
expect-mode: normal

=== regex very nomagic with magic dot
text:
  a.c abc
cursor: 1,2
keys: /\Va\.c<CR>
--- vim 9.1
expect-text:
  a.c abc
expect-cursor: 1,5
expect-mode: normal

=== regex caret in the middle is literal
text:
  a^b ab
cursor: 1,3
keys: /a^b<CR>
--- vim 9.1
expect-text:
  a^b ab
expect-cursor: 1,1
expect-mode: normal

=== regex dollar in the middle is literal
text:
  a$b ab
cursor: 1,3
keys: /a$b<CR>
--- vim 9.1
expect-text:
  a$b ab
expect-cursor: 1,1
expect-mode: normal

=== regex dollar at the end
text:
  ab
  xab
cursor: 1,1
keys: /ab$<CR>
--- vim 9.1
expect-text:
  ab
  xab
expect-cursor: 2,2
expect-mode: normal

=== regex caret at the start
text:
  xab
  ab
cursor: 1,1
keys: /^ab<CR>
--- vim 9.1
expect-text:
  xab
  ab
expect-cursor: 2,1
expect-mode: normal

=== regex caret after alternation
text:
  x ab
  ab
cursor: 1,1
keys: /zz\|^ab<CR>
--- vim 9.1
expect-text:
  x ab
  ab
expect-cursor: 2,1
expect-mode: normal

=== regex star at the start is literal
text:
  a*b *b
cursor: 1,1
keys: /*b<CR>
--- vim 9.1
expect-text:
