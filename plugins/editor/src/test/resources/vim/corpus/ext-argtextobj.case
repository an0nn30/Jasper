# argtextobj (plan V4b): ia and aa, function arguments.

=== dia on the first argument
text:
  foo(one, two, three)
cursor: 1,6
ext: argtextobj
keys: dia
registers: " 0 1 -
--- vim 9.1
expect-text:
  foo(, two, three)
expect-cursor: 1,5
expect-mode: normal
expect-register ": c "one"
expect-register 0: c ""
expect-register 1: none
expect-register -: c "one"

