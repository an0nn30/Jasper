# textobj-indent (plan V4b): ii, ai, aI and iI, blocks of lines by indent.

=== dii deletes the block
text:
  def f():
      if x:
          a = 1
  $
          b = 2
      return a
  $
  def g():
      pass
cursor: 3,9
ext: textobj-indent
keys: dii
registers: " 0 1 -
--- vim 9.1
expect-text:
  def f():
      if x:
      return a
  $
  def g():
      pass
expect-cursor: 3,5
expect-mode: normal
expect-register ": l "        a = 1\n\n        b = 2\n"
expect-register 0: none
expect-register 1: l "        a = 1\n\n        b = 2\n"
expect-register -: none

