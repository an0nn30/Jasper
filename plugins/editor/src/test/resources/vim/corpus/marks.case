# Marks, the jumplist, the change list and gi.

=== m then backtick returns to the mark
text:
  line one
    line two
  line three
  line four
  line five
cursor: 2,5
keys: majj`a
--- vim 9.1
expect-text:
  line one
    line two
  line three
  line four
  line five
expect-cursor: 2,5
expect-mode: normal

=== m then quote goes to the first non-blank
text:
  line one
    line two
  line three
  line four
  line five
cursor: 2,7
keys: majj'a
--- vim 9.1
expect-text:
  line one
    line two
  line three
  line four
  line five
expect-cursor: 2,3
expect-mode: normal

