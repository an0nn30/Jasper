=== d backtick deletes to the mark
text:
  line one
    line two
  line three
  line four
  line five
cursor: 1,3
keys: majjl d`a
registers: " 0 1 -
--- vim 9.1
expect-text:
  li three
  line four
  line five
expect-cursor: 1,3
expect-mode: normal
expect-register ": c "ne one\n  line two\nline"
expect-register 0: none
expect-register 1: c "ne one\n  line two\nline"
expect-register -: none

=== d quote deletes lines to the mark
text:
  line one
    line two
  line three
  line four
  line five
cursor: 1,3
keys: majjd'a
registers: " 0 1 -
--- vim 9.1
expect-text:
  line four
  line five
expect-cursor: 1,1
expect-mode: normal
expect-register ": l "line one\n  line two\nline three\n"
expect-register 0: none
expect-register 1: l "line one\n  line two\nline three\n"
expect-register -: none

=== y backtick
text:
  line one
    line two
  line three
  line four
  line five
cursor: 1,3
keys: majly`a
registers: " 0 1 -
--- vim 9.1
expect-text:
  line one
    line two
  line three
  line four
  line five
expect-cursor: 1,3
expect-mode: normal
expect-register ": c "ne one\n  l"
expect-register 0: c "ne one\n  l"
expect-register 1: none
expect-register -: none

