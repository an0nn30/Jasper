# Ex :global and :vglobal (V2a).

=== g deletes matching lines
text:
  a1
  b2
  a3
  b4
  a5
cursor: 1,1
keys: :g/a/d<CR>
output: yes
--- vim 9.1
expect-text:
  b2
  b4
expect-cursor: 2,1
expect-mode: normal
expect-output:
  3 fewer lines

=== g bang keeps matching lines
text:
  a1
  b2
  a3
  b4
  a5
cursor: 1,1
keys: :g!/a/d<CR>
--- vim 9.1
expect-text:
  a1
  a3
  a5
expect-cursor: 3,1
expect-mode: normal

