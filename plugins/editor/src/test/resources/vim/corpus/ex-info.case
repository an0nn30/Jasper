# Ex listings and settings: :print :number :list := :k :mark :delmarks :marks :jumps :changes :registers :nohlsearch :set (V2a).

=== p prints the line
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 2,1
keys: :p<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 2,1
expect-mode: normal
expect-output:
  two

=== capital P prints the line
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 2,1
keys: :P<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 2,1
expect-mode: normal
expect-output:
  two

=== p prints a range
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :2,3p<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 3,1
expect-mode: normal
expect-output:
  two
  three

=== p cursor goes to the last line
text:
  alpha
    beta
      gamma
  delta
cursor: 1,1
keys: :1,3p<CR>
--- vim 9.1
expect-text:
  alpha
    beta
      gamma
  delta
expect-cursor: 3,5
expect-mode: normal

=== p shows tabs as spaces
text:
  a	b
  	x
cursor: 1,1
keys: :%p<CR>
output: yes
--- vim 9.1
expect-text:
  a	b
  	x
expect-cursor: 2,2
expect-mode: normal
expect-output:
  a       b
          x

=== l lists tabs and ends
text:
  a	b
   x $
cursor: 1,1
keys: :%l<CR>
output: yes
--- vim 9.1
expect-text:
  a	b
   x $
expect-cursor: 2,2
expect-mode: normal
expect-output:
  a^Ib$$
   x $$

=== number prints numbers
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :2,3nu<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 3,1
expect-mode: normal
expect-output:
    2 two
    3 three

=== hash prints numbers
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :#<CR>
output: yes
--- vim 9.1
expect-text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 1,1
expect-mode: normal
expect-output:
    1 one

