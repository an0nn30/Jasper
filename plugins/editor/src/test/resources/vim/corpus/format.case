=== gq with tabs inside
text:
  a	b	c	d	e	f
cursor: 1,1
set: textwidth=20
keys: gqq
--- vim 9.1
expect-text:
  a	b	c
  d	e	f
expect-cursor: 2,1
expect-mode: normal

=== gq on wide characters
text:
  日本語 日本語 日本語 日本語 日本語
cursor: 1,1
set: textwidth=12
keys: gqq
--- vim 9.1
expect-text:
  日本語
  日本語
  日本語
  日本語
  日本語
expect-cursor: 5,1
expect-mode: normal

=== gq on a paragraph with a long joined line
text:
  a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a a $
  b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b b $
cursor: 1,1
set: textwidth=20
keys: gqj
--- vim 9.1
expect-text:
  a a a a a a a a a a
  a a a a a a a a a a
  a a a a a a a a a a
  a a a a a a a a a a
  b b b b b b b b b b
  b b b b b b b b b b
  b b b b b b b b b b
  b b b b b b b b b b $
expect-cursor: 8,1
expect-mode: normal

=== gq on nroff macro lines
text:
  .TH x
  a
  b
cursor: 1,1
keys: gqG
--- vim 9.1
expect-text:
  .TH x a b
expect-cursor: 1,1
expect-mode: normal

=== d C-v j deletes a block
text:
  abcd
  efgh
  ijkl
cursor: 1,2
keys: d<C-v>jl
--- vim 9.1
expect-text:
  acd
  egh
  ijkl
expect-cursor: 1,3
expect-mode: normal

=== y C-v then p
text:
  abcd
  efgh
  ijkl
cursor: 1,2
keys: y<C-v>jl$p
registers: "
--- vim 9.1
expect-text:
  abcdb
  efghf
  ijkl
expect-cursor: 1,5
expect-mode: normal
expect-register ": b1 "b\nf"

=== d C-v dollar
text:
  abcd
  ef
  ijkl
cursor: 1,2
keys: d<C-v>j$
--- vim 9.1
expect-text:
  acd
  e
  ijkl
expect-cursor: 1,3
expect-mode: normal

=== c C-v j
text:
  abcd
  efgh
cursor: 1,2
keys: c<C-v>jX<Esc>
--- vim 9.1
expect-text:
  aXcd
  eXgh
expect-cursor: 1,2
expect-mode: normal

=== d C-v j then dot
text:
  abcd
  efgh
  ijkl
  mnop
cursor: 1,2
keys: d<C-v>jjj.
--- vim 9.1
expect-text:
  acd
  egh
  ikl
  mop
expect-cursor: 3,2
expect-mode: normal

=== d C-v j then gv
text:
  abcd
  efgh
  ijkl
cursor: 1,2
keys: d<C-v>jgv
--- vim 9.1
expect-text:
  acd
  egh
  ijkl
expect-cursor: 2,2
expect-mode: visual-block
expect-visual: 1,2

=== d C-v with a count
text:
  abcd
  efgh
  ijkl
cursor: 1,1
keys: d<C-v>2j
--- vim 9.1
expect-text:
  bcd
  fgh
  jkl
expect-cursor: 1,1
expect-mode: normal

=== gU C-v j
text:
  abcd
  efgh
cursor: 1,2
keys: gU<C-v>jl
--- vim 9.1
expect-text:
  aBcd
  eFgh
expect-cursor: 1,3
expect-mode: normal
