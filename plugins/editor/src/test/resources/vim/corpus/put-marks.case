=== marks after vp multi-line
text:
  one two three
  four five
cursor: 1,5
register a: c "x\ny"
keys: viw"ap:marks []<CR>
output: yes
--- vim 9.1
expect-text:
  one x
  y three
  four five
expect-cursor: 1,5
expect-mode: normal
expect-output:
  mark line  col file/text
   [      1    4 one x
   ]      2    0 y three

=== marks after Vp
text:
  one two three
  four five
cursor: 2,3
register a: l "x\ny\n"
keys: V"ap:marks []<CR>
output: yes
--- vim 9.1
expect-text:
  one two three
  x
  y
expect-cursor: 2,1
expect-mode: normal
expect-output:
  mark line  col file/text
   [      2    0 x
   ]      3    0 y
