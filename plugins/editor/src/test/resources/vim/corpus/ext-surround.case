expect-cursor: 1,5
expect-mode: normal

=== ys over two words
text:
  one two three
cursor: 1,1
ext: surround
keys: ys2w*
--- vim 9.1
expect-text:
  *one two* three
expect-cursor: 1,1
expect-mode: normal

=== ys over a linewise motion
text:
  one
  two
  three
cursor: 1,1
ext: surround
keys: ysj)
--- vim 9.1
expect-text:
  (
  one
  two
  )
  three
expect-cursor: 1,1
expect-mode: normal

=== yss surrounds the line's text
text:
    one two  $
cursor: 1,4
ext: surround
keys: yss)
--- vim 9.1
expect-text:
    (one two)  $
expect-cursor: 1,3
expect-mode: normal

