=== ds with an opening bracket trims spaces
text:
  f( a b )
cursor: 1,5
ext: surround
keys: ds(
--- vim 9.1
expect-text:
  fa b
expect-cursor: 1,2
expect-mode: normal

=== ds with a closing bracket keeps spaces
text:
  f( a b )
cursor: 1,5
ext: surround
keys: ds)
--- vim 9.1
expect-text:
  f a b $
expect-cursor: 1,2
expect-mode: normal

