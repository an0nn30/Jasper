expect-cursor: 1,9
expect-mode: normal

=== cs with t reads the tag
text:
  He said "hello" to (them) now
cursor: 1,11
ext: surround
keys: cs"tem<CR>
--- vim 9.1
expect-text:
  He said <em>hello</em> to (them) now
expect-cursor: 1,9
expect-mode: normal

=== cs from a tag to quotes
text:
  <b>bold</b>
cursor: 1,5
ext: surround
keys: cst"
--- vim 9.1
expect-text:
  "bold"
expect-cursor: 1,1
expect-mode: normal

=== cs from a tag keeps its attributes
text:
  <a href="x">t</a>
cursor: 1,14
ext: surround
keys: csttb<CR>
--- vim 9.1
expect-text:
  <b href="x">t</b>
expect-cursor: 1,1
expect-mode: normal

=== cs from a tag drops the attributes with a closing bracket
text:
  <a href="x">t</a>
cursor: 1,14
ext: surround
keys: cstt<lt>b>
--- vim 9.1
expect-text:
  <<b>t</<b>
expect-cursor: 1,1
expect-mode: normal

