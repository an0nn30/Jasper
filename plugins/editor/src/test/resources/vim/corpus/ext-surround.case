# surround (tpope/vim-surround): ds, cs, cS, ys, yS, yss, ySS and Visual S and gS.

=== ds removes double quotes
text:
  He said "hello" to (them) now
cursor: 1,11
ext: surround
keys: ds"
registers: "
--- vim 9.1
expect-text:
  He said hello to (them) now
expect-cursor: 1,9
expect-mode: normal
expect-register ": c ""

=== ds removes parentheses
text:
  He said "hello" to (them) now
cursor: 1,22
ext: surround
keys: ds(
--- vim 9.1
expect-text:
  He said "hello" to them now
expect-cursor: 1,20
expect-mode: normal

