=== dot repeats ds
text:
  "a" "b"
cursor: 1,2
ext: surround
keys: ds"w.
--- vim 9.1
expect-text:
  a b
expect-cursor: 1,3
expect-mode: normal

=== dot repeats cs
text:
  "a" "b"
cursor: 1,2
ext: surround
keys: cs"'w.
--- vim 9.1
expect-text:
  'a' 'b'
expect-cursor: 1,5
expect-mode: normal

=== dot repeats ys
text:
  one two three
cursor: 1,1
ext: surround
keys: ysiw)ww.
--- vim 9.1
expect-text:
  (one()) two three
expect-cursor: 1,5
expect-mode: normal

=== dot repeats cs with a tag
text:
  "a" "b"
cursor: 1,2
ext: surround
keys: cs"tp<CR>w.
--- vim 9.1
expect-text:
  <p>a</p> <p>b</p>
expect-cursor: 1,10
expect-mode: normal

=== u undoes ds in one step
text:
  He said "hello" to (them) now
cursor: 1,11
ext: surround
keys: ds"u
--- vim 9.1
expect-text:
  He said "hello" to (them) now
expect-cursor: 1,10
expect-mode: normal

=== the default mappings
text:
  x
cursor: 1,1
ext: surround
keys: :nmap ys<CR>:nmap cs<CR>:nmap ds<CR>:xmap S<CR>
output: yes
--- vim 9.1
expect-text:
  x
expect-cursor: 1,1
expect-mode: normal
expect-output:
  n  yss           <Plug>Yssurround
  n  ys            <Plug>Ysurround
  n  cs            <Plug>Csurround
  n  ds            <Plug>Dsurround
  x  S             <Plug>VSurround
