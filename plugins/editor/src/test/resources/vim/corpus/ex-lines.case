# Ex line commands: :d :y :> :< :put :join :move :copy :normal :sort :left :right :center :undo (V2a).

=== d deletes the line
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 3,1
keys: :d<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  one
  two
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 3,1
expect-mode: normal
expect-register ": l "three\n"
expect-register 0: none
expect-register 1: l "three\n"
expect-register a: none
expect-register -: none

=== d range into a register
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :2,3d a<CR>
registers: " 0 1 a -
--- vim 9.1
expect-text:
  one
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 2,1
expect-mode: normal
expect-register ": l "two\nthree\n"
expect-register 0: none
expect-register 1: l "two\nthree\n"
expect-register a: l "two\nthree\n"
expect-register -: none

=== d uppercase register appends
text:
  one
  two
  three
  four
  five
  six
  seven
  eight
  nine
  ten
cursor: 1,1
keys: :1d a<CR>:1d A<CR>
registers: a
--- vim 9.1
expect-text:
  three
  four
  five
  six
  seven
  eight
  nine
  ten
expect-cursor: 1,1
expect-mode: normal
expect-register a: l "one\ntwo\n"

