=== the default mappings
text:
  a
cursor: 1,1
ext: matchit
keys: :nmap %<CR>:omap ]%<CR>:xmap a%<CR>
output: yes
--- vim 9.1
expect-text:
  a
expect-cursor: 1,1
expect-mode: normal
expect-output:
  n  %             <Plug>(MatchitNormalForward)
  o  ]%            <Plug>(MatchitOperationMultiForward)
  x  a%            <Plug>(MatchitVisualTextObject)

