expect-cursor: 1,1
expect-mode: normal
expect-register ": c "#if A\nint f(a, (b)) {\n  /* x */\n#else\n  g();\n#en"
expect-register 0: none
expect-register 1: c "#if A\nint f(a, (b)) {\n  /* x */\n#else\n  g();\n#en"
expect-register -: none

