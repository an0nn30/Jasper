=== d% on a parenthesis
text:
  #if A
  int f(a, (b)) {
    /* x */
  #else
    g();
  #endif
cursor: 2,6
ext: matchit
keys: d%
registers: " 0 1 -
--- vim 9.1
expect-text:
  #if A
  int f {
    /* x */
  #else
    g();
  #endif
expect-cursor: 2,6
expect-mode: normal
expect-register ": c "(a, (b))"
expect-register 0: none
expect-register 1: none
expect-register -: c "(a, (b))"

=== d% on if takes the whole else
text:
  #if A
  int f(a, (b)) {
    /* x */
  #else
    g();
  #endif
cursor: 1,1
ext: matchit
keys: d%
registers: " 0 1 -
--- vim 9.1
expect-text:
  $
    g();
  #endif
expect-cursor: 1,1
expect-mode: normal
expect-register ": c "#if A\nint f(a, (b)) {\n  /* x */\n#else"
expect-register 0: none
expect-register 1: c "#if A\nint f(a, (b)) {\n  /* x */\n#else"
expect-register -: none

=== d% on endif
text:
  #if A
  int f(a, (b)) {
    /* x */
  #else
    g();
  #endif
cursor: 6,3
ext: matchit
