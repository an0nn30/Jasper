# matchit (plan V4c): %, g%, [%, ]% and a% over the words of a group.

=== % on a parenthesis
text:
  #if A
  int f(a, (b)) {
    /* x */
  #else
    g();
  #endif
cursor: 2,6
ext: matchit
keys: %
--- vim 9.1
expect-text:
  #if A
  int f(a, (b)) {
    /* x */
  #else
    g();
  #endif
expect-cursor: 2,13
expect-mode: normal

