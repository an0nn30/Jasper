// Hand-written for Jasper's tests. No rule here comes from EasyList or any other filter list; the hosts are made up.
// RuleSetIndexTest drops these comment lines and reads the rest as a WebKit content-blocker list (JSON).
[
  {"trigger": {"url-filter": "^[^:]+:(//)?([^/]+\\.)?adnet\\.test[/:]"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^[^:]+:(//)?([^/]+\\.)?tracker\\.test[/:]", "load-type": ["third-party"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://([^/]+\\.)?pixel\\.example\\.net/", "resource-type": ["image"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/banner/[0-9]+x[0-9]+\\."}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "\\.swf$", "resource-type": ["media", "other"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/ads/"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "[/_.-]advert[/_.-]"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "_adserver\\."}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/pagead/", "resource-type": ["script"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "analytics\\.js", "load-type": ["third-party"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "metrics\\.example\\.org/collect", "resource-type": ["raw", "fetch", "ping"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^wss?://([^/]+\\.)?socket-ads\\.test", "resource-type": ["websocket"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/AdBanner/", "url-filter-is-case-sensitive": true}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "\\?adid="}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "-ad-[0-9]+\\.gif", "resource-type": ["image"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://cdn\\.example\\.com/promo/", "if-domain": ["*news.example.co.uk"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/sponsor", "unless-domain": ["*sponsor-friends.test"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "track(ing)?\\.gif"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": ".*", "resource-type": ["popup"], "if-domain": ["*popups.test"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": ".*", "resource-type": ["font"], "load-type": ["third-party"], "unless-domain": ["*trusted.test", "news.example.co.uk"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "ad[sv]", "resource-type": ["style-sheet"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://[^/]*\\.ads\\.example/"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/widget\\.js\\?", "if-domain": ["shop.test"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/beacon", "resource-type": ["ping"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "[?&]utm_[a-z]+=", "resource-type": ["image"], "load-type": ["third-party"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://([^/]+\\.)?video\\.example/preroll/", "resource-type": ["media", "raw"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "/popunder\\.", "resource-type": ["popup", "script"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "(/ad)+x"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "Tracking", "url-filter-is-case-sensitive": true, "resource-type": ["raw"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://ads?[0-9]*\\."}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^[^:]+:(//)?([^/]+\\.)?adnet\\.test/allowed/"}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "/ads/self-promo", "if-domain": ["*shop.test"]}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": ".*", "if-domain": ["*trusted.test"]}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "tracker\\.test/optout"}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "/ads/self-promo/popup"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "\\.swf\\?allow=1$"}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "/AdBanner/House", "url-filter-is-case-sensitive": true}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": ".*", "resource-type": ["image"], "load-type": ["first-party"]}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "/ads/late/"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "^https?://([^/]+\\.)?adnet\\.test/allowed/but-not-this"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "\\.gif\\?ref=", "load-type": ["first-party"], "if-domain": ["*shop.test", "market.test"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": ".*"}, "action": {"type": "css-display-none", "selector": ".ad-banner"}},
  {"trigger": {"url-filter": ".*"}, "action": {"type": "css-display-none", "selector": "#sponsored-box"}},
  {"trigger": {"url-filter": "^.*$"}, "action": {"type": "css-display-none", "selector": "div[id^=\"ad-slot\"]"}},
  {"trigger": {"url-filter": ".*", "if-domain": ["*news.example.co.uk"]}, "action": {"type": "css-display-none", "selector": ".sidebar-ad"}},
  {"trigger": {"url-filter": ".*", "if-domain": ["shop.test", "*market.test"]}, "action": {"type": "css-display-none", "selector": ".shop-promo"}},
  {"trigger": {"url-filter": ".*", "unless-domain": ["*shop.test"]}, "action": {"type": "css-display-none", "selector": ".promo"}},
  {"trigger": {"url-filter": "^https?://([^/]+\\.)?video\\.example/watch"}, "action": {"type": "css-display-none", "selector": ".overlay-ad"}},
  {"trigger": {"url-filter": ".*", "if-domain": ["*clean.test"]}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": ".*"}, "action": {"type": "css-display-none", "selector": ".after-clean"}},
  {"trigger": {"url-filter": ".*", "load-type": ["third-party"]}, "action": {"type": "css-display-none", "selector": ".third"}},
  {"trigger": {"url-filter": ".*", "resource-type": ["image"]}, "action": {"type": "css-display-none", "selector": ".img-only"}},
  {"trigger": {"url-filter": "/article/", "if-domain": ["*news.example.co.uk"]}, "action": {"type": "css-display-none", "selector": "aside.related-ads"}},
  {"trigger": {"url-filter": "\\?print=1"}, "action": {"type": "ignore-previous-rules"}},
  {"trigger": {"url-filter": "Promo", "url-filter-is-case-sensitive": true}, "action": {"type": "css-display-none", "selector": ".case-promo"}},
  {"trigger": {"url-filter": "ab"}, "action": {"type": "css-display-none", "selector": ".short"}},
  {"trigger": {"url-filter": "/gallery/", "unless-domain": ["*video.example"]}, "action": {"type": "css-display-none", "selector": "ul.gallery-ads > li"}},
  {"trigger": {"url-filter": ".*", "if-domain": ["*shop.test"], "resource-type": ["document"]}, "action": {"type": "css-display-none", "selector": ".shop-banner"}},
  {"trigger": {"url-filter": "(a+)+b"}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "ads", "if-top-url": ["https://x.test"]}, "action": {"type": "block"}},
  {"trigger": {"url-filter": "ads"}, "action": {"type": "make-https"}},
  {"trigger": {"url-filter": ".*"}, "action": {"type": "css-display-none", "selector": "a{background:url(https://x.test/)}"}}
]
