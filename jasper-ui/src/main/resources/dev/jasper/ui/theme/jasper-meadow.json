  "editor": {
    "light": {
      "background": "terminal.bg",
      "foreground": "terminal.fg",
      "caret": "terminal.cursor",
      "selection": "terminal.selection",
      "currentLine": "hover.overlay @ 5%",
      "gutter": "terminal.bg",
      "lineNumbers": "text.tertiary",
      "keyword": "terminal.ansi.magenta",
      "type": "terminal.ansi.cyan",
      "function": "terminal.ansi.blue",
      "variable": "terminal.fg",
      "constant": "terminal.ansi.yellow",
      "number": "terminal.ansi.yellow",
      "string": "terminal.ansi.green",
      "comment": "terminal.ansi.white, italic",
      "doc_comment": "terminal.ansi.white, italic",
      "annotation": "terminal.ansi.yellow",
      "operator": "text.secondary",
      "punctuation": "text.secondary",
      "tag": "terminal.ansi.red",
      "attribute": "terminal.ansi.yellow",
      "regex": "terminal.ansi.cyan",
      "error": "terminal.ansi.red"
    }
